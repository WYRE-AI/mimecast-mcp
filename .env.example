# stdio (Claude Desktop / CLI) and AUTH_MODE=env read these.
# Gateway mode ignores them and requires the X-Mimecast-* headers instead.
MIMECAST_CLIENT_ID=
MIMECAST_CLIENT_SECRET=
MIMECAST_REGION=us

# stdio (default) or http
MCP_TRANSPORT=stdio

# gateway: X-Mimecast-Client-ID and X-Mimecast-Client-Secret on each /mcp request.
#          Never falls back to MIMECAST_* . Docker image and Compose default.
# env:     use MIMECAST_* after X-Gateway-S2S verifies.
AUTH_MODE=gateway

# Required to start the HTTP transport. The process exits if this is empty.
# Compose will not start when it is unset. Never commit a real value.
CONDUIT_S2S_SECRET=

# Local development only. Set to 1 to start HTTP without CONDUIT_S2S_SECRET.
# Logs a warning and does not enforce X-Gateway-S2S. Refuses to start unless
# MCP_HTTP_HOST is loopback (127.0.0.1, localhost, or ::1). Do not use in production.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address for HTTP. Defaults to 127.0.0.1. The container image sets 0.0.0.0.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

LOG_LEVEL=info
